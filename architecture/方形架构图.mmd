flowchart LR
    A(["输入：测试目标与被测系统　·　固定总预算 B₀　·　可用 Agent、模型与工具"])
    subgraph R["01  在线测试编排：观察 → 决策 → 执行 → 反馈"]
      direction TB
      subgraph R1["状态构建与联合决策"]
        direction LR
        S["测试状态<br/>任务与依赖<br/>环境与证据<br/>剩余预算"] --> G["状态编码<br/>任务—Agent—环境<br/>—证据异构图<br/>预算条件表示"] --> V["价值与成本估计<br/>协作增量收益<br/>成本与不确定性<br/>待验证需求"] --> P["联合调度<br/>选择任务、配置、模型<br/>与执行预算上限<br/>可选有限前瞻"]
      end
      subgraph R2["预算准入与执行反馈"]
        direction LR
        B{"可行性准入<br/>预算 / 依赖 / 冲突"} --> L[("共享预算账本<br/>原子预留<br/>结算与回收")] --> X["受限测试执行<br/>Agent 与工具调用<br/>成本上限"] --> O["结果验证与反馈<br/>复现 · 确认 · 去重<br/>更新状态与轨迹"]
      end
      R1 --> R2
    end
    subgraph D["02  数据采集与训练：受控比较 → 表示学习 → 策略优化"]
      direction TB
      subgraph D1["可复现实验与数据"]
        direction LR
        K["环境隔离<br/>恢复相同初始状态"] --> T["受控配置比较<br/>配置和预算随机化<br/>记录选择概率"] --> LOG["完整轨迹记录<br/>状态 · 动作 · 成本<br/>结果与后续策略"] --> DS[("数据集<br/>训练 / 验证 / 测试<br/>按任务或应用划分")]
      end
      subgraph D2["候选模型与策略训练"]
        direction LR
        REP["状态表示学习<br/>轨迹 / 图编码"] --> EST["收益与成本学习<br/>增量价值 · 价值排序<br/>成本分布"] --> POL["调度策略训练<br/>结构化模仿 / 离线学习<br/>可选在线强化学习"] --> MOD[("版本化模型<br/>通过评估后发布")]
      end
      D1 --> D2
    end
    subgraph E["03  实验评估与迭代"]
      direction LR
      BASE["对照与消融<br/>固定 / 动态预算 ×<br/>固定 / 动态协作"] --> FAIR["公平比较<br/>相同预算、工具、权限<br/>验证标准与总成本"] --> MET["效果与可靠性<br/>独立确认缺陷 / 场景完成<br/>预算违规 / 跨任务泛化"] --> NEXT["迭代与实施<br/>分析差异及额外成本<br/>更新假设、采样与模型"]
    end
    A --> R --> D --> E
    subgraph FEED["跨轮反馈：执行结果进入数据集；通过评估的模型用于在线调度；验证结果更新状态"]
    end
    E --- FEED
    style FEED fill:#f7f9fc,stroke:#dce4ef,color:#48586c
    classDef state fill:#eaf3ff,stroke:#6595c9,color:#173754
    classDef model fill:#f2edff,stroke:#977bc6,color:#38285d
    classDef safe fill:#fff3dc,stroke:#c89135,color:#553a12
    classDef execute fill:#e8f8ef,stroke:#61a77e,color:#173e2a
    classDef data fill:#e7f6f6,stroke:#5ba3a1,color:#153d3d
    classDef eval fill:#fff0ed,stroke:#c8877d,color:#4c2623
    class A,S,G state
    class V,P,REP,EST,POL,MOD model
    class B,L safe
    class X,O execute
    class K,T,LOG,DS data
    class BASE,FAIR,MET,NEXT eval
